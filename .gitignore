.dart_tool/
.packages
.pub-cache/
.pub/
.flutter-plugins
.flutter-plugins-dependencies
.build/

# Flutter SDK（本地开发环境，不上传）
flutter_sdk/
*.zip

# 构建产物
build/
android/app/build/
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec

# 书籍原始文件（epub/md 过大，不上传），仅保留 .gitkeep 占位保证目录存在
# 注意：books/ 必须带前导斜杠，否则会匹配任意层级的 books 目录（含 assets/books/），导致否定规则失效
/books/
assets/books/*
!assets/books/.gitkeep

# 本地配置（包含 API Key 等敏感信息）
.appdata/
*.key
*.pem

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
*.iml

# 系统文件
.DS_Store
Thumbs.db

# 日志
*.log

# 数据库
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# 测试
test/.test_coverage.dart

# Python / 服务端
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
server/.env
server/deploy.conf
server/deploy/

# 临时文件
*.tmp
*.bak

# Kotlin/Gradle 编译缓存
android/.kotlin/

# 本地工具链与临时输出（体积大，不入库）
android_sdk/
jdk17/
.analyze_out.txt
.pubget_out.txt
.build_out.txt
.test_out.txt
.kotlin-cache/
.userhome/

