# ===== 数据库 =====
DATABASE_URL=postgresql+asyncpg://wendao:change-me-strong-password@db:5432/wendao

# ===== JWT（务必改成 32 字节以上的随机串：openssl rand -hex 32）=====
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ===== 限流与同步 =====
LOGIN_RATE_LIMIT=10
PUSH_BATCH_LIMIT=500
PULL_PAGE_LIMIT=500

# ===== 其他 =====
CORS_ORIGINS=["*"]
AUTO_CREATE_TABLES=true

# ===== PostgreSQL（docker-compose 用）=====
POSTGRES_USER=wendao
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=wendao

# ===== cloudflared 隧道（Tunnel Token 从 Cloudflare Zero Trust 控制台获取）=====
CLOUDFLARED_TOKEN=your-tunnel-token-here
